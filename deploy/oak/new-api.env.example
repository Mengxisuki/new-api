# Generate independent random secrets on the server; never copy development data.
SQL_DSN=postgresql://new_api:CHANGE_ME@127.0.0.1:5432/new_api?sslmode=disable
REDIS_CONN_STRING=redis://127.0.0.1:6379/0
SESSION_SECRET=CHANGE_ME
CRYPTO_SECRET=CHANGE_ME
# HTTPS cookies and origin checks must match the public domain exactly.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://oak.qingshukeji.top
TRUSTED_PROXIES=127.0.0.1,::1
# Database and cache ports stay private; UFW also blocks the gateway port.
PORT=3000
TZ=Asia/Shanghai
DEFAULT_LANGUAGE=zh-CN
# Bound database connections and Go memory usage for a 1.7 GiB server.
SQL_MAX_IDLE_CONNS=5
SQL_MAX_OPEN_CONNS=20
GOMEMLIMIT=768MiB
# Use persistent logs and the application's batch update support.
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=oak-new-api-1
